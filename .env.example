# Copy this file to .env. Never commit .env.

# The Postgres database of the harness. Use the harness_app role (db/migrations/0003_harness_role.sql).
# The harness never creates tables: apply db/migrations/ first (db/README.md).
HARNESS_DATABASE_URL=postgresql://harness_app:<password>@<host>:5432/<database>

# For npm test only: a throwaway local Postgres. scripts/test-db.sh start prints this line.
HARNESS_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:<port>/postgres
