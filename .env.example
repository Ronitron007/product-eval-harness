# Copy this file to .env. Never commit .env.

# The Postgres database of the harness. Use the harness_app role (db/migrations/0003_harness_role.sql).
# The harness never creates tables: apply db/migrations/ first (db/README.md).
HARNESS_DATABASE_URL=postgresql://harness_app:<password>@<host>:5432/<database>

# For npm test only: a throwaway local Postgres. scripts/test-db.sh start prints this line.
HARNESS_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:<port>/postgres

# The tool server (docs/design/tool-registry.md, tools.secrets_off_argv). Each agent run starts its
# own server process, which reads its secrets from this file. HARNESS_ENV_FILE names the file. It
# defaults to the .env file of the repo.
# HARNESS_ENV_FILE=/path/to/.env

# The toggles of a run, as one JSON value (tools.toggles). The default turns on each toolset, with
# allowEffects ["read"]. A paid or db_write tool stays off until a run names its effect.
# HARNESS_TOOLS={"toolsets":{"research":false},"allowEffects":["read"]}

# The Claude CLI of an agent run on claude -p (tools.agent_run). The run uses the CLI login and no API key.
# CLAUDE_CLI_PATH=/path/to/claude
