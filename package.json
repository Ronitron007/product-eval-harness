{
  "name": "product-eval-harness",
  "version": "0.0.0",
  "description": "An evaluation harness for consumer products: a rule graph, ruleset judges and LLM agents, built on Mastra.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ronitron007/product-eval-harness.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "MASTRA_TELEMETRY_DISABLED=1 mastra dev",
    "build": "MASTRA_TELEMETRY_DISABLED=1 mastra build",
    "start": "MASTRA_TELEMETRY_DISABLED=1 mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rules:check": "tsx src/rules/cli.ts check rules",
    "rules:lock": "tsx src/rules/cli.ts lock rules"
  },
  "dependencies": {
    "@mastra/core": "1.79.0",
    "@mastra/libsql": "1.27.0",
    "canonicalize": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "mastra": "1.35.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
